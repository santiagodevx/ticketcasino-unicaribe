generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TicketType {
  ALMUERZO
  MERIENDA
}

enum TicketStatus {
  ACTIVO
  USADO
  VENCIDO
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Employee {
  id        String   @id @default(cuid())
  document  String   @unique
  name      String
  active    Boolean  @default(true)
  passkey   Json?
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Ticket {
  id         String       @id @default(cuid())
  type       TicketType
  status     TicketStatus @default(ACTIVO)
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  usedAt     DateTime?
  employee   Employee     @relation(fields: [employeeId], references: [id])
  employeeId String

  @@index([employeeId])
  @@index([status])
  @@index([type, status])
}
