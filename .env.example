# ──────────────────────────────────────────────────────────────────────────────
# TicketCasino — Variables de entorno para Docker
# Copia este archivo como .env y ajusta los valores antes de correr:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# Base de datos
MYSQL_ROOT_PASSWORD=tc_root_2026
MYSQL_DATABASE=ticketcasino_db
MYSQL_USER=casino_user
MYSQL_PASSWORD=casino_pass_2026

# JWT — cambia esto en producción real
JWT_SECRET=super_secret_jwt_ticketcasino_2026_changeme

# Puerto público de la app (nginx)
APP_PORT=80

# URL del frontend (para CORS del backend)
FRONTEND_URL=http://localhost

# Credenciales del admin por defecto (se crean al levantar si no existen)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123

